{
  "name": "boipoka",
  "version": "1.0.0",
  "description": "Boipoka - a cross-platform Bengali e-book reader (Apple Books style) with Bijoy->Unicode conversion and Avro phonetic input.",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "postinstall": "node scripts/copy-web-deps.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/run-tests.ts"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.2.0",
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "bn-ansi-to-unicode": "^1.0.1",
    "expo": "~52.0.0",
    "expo-document-picker": "~13.0.0",
    "expo-file-system": "~18.0.0",
    "expo-font": "~13.0.0",
    "expo-sqlite": "~15.0.0",
    "expo-asset": "~11.0.0",
    "expo-status-bar": "~2.0.0",
    "jszip": "^3.10.1",
    "nodejs-avro-phonetic": "^1.0.2",
    "react": "18.3.1",
    "react-native": "0.76.9",
    "react-native-pdf": "^6.7.1",
    "react-native-safe-area-context": "^4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-webview": "13.12.5",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.7.2"
  },
  "private": true
}
